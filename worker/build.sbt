// The runtime dependencies of each helper live in deps/<helper>.txt so that the scpm CLI can
// resolve exactly the same classpath through coursier. This build reads them from there.
def runtimeDeps(helper: String): Seq[ModuleID] =
  IO.readLines(file(s"deps/$helper.txt")).map(_.trim).filter(_.nonEmpty).map { line =>
    line.split(':') match
      case Array(org, name, version) => org % name % version
      case _ => sys.error(s"deps/$helper.txt: expected org:name:version, got '$line'")
  }

val workerDeps = runtimeDeps("compile-worker")
def workerDepVersion(name: String): String =
  workerDeps.find(_.name == name).getOrElse(sys.error(s"deps/compile-worker.txt lacks $name")).revision

ThisBuild / organization := "dev.scpm"
ThisBuild / version := "0.1.0"
ThisBuild / scalaVersion := workerDepVersion("scala3-library_3")
ThisBuild / scalacOptions ++= Seq("-deprecation", "-feature", "-Wunused:all")

lazy val root = project
  .in(file("."))
  .aggregate(compileWorker, testRunner, resolver)
  .settings(publish / skip := true)

lazy val resolverJars = taskKey[Seq[File]]("The resolver's jar and its runtime closure, in classpath order")
lazy val stage =
  taskKey[File]("Copies the resolver's jars to target/out/jvm/resolver-stage, which development builds of scpm use")
lazy val bootstrapList =
  taskKey[File]("Writes resolver/bootstrap.txt: name, sha256 and size of each jar of the resolver's closure")

def sha256(f: File): String =
  val md = java.security.MessageDigest.getInstance("SHA-256")
  md.update(IO.readBytes(f))
  md.digest().map("%02x".format(_)).mkString

// The resolver sidecar (design §5.2.1): coursier behind JSON lines on stdio. Its own jars can't be
// resolved by it, so each scpm release carries their list (`bootstrapList`) and uploads the jars.
lazy val resolver = project
  .in(file("resolver"))
  .settings(
    name := "scpm-resolver",
    Compile / mainClass := Some("scpm.resolver.Main"),
    libraryDependencies ++= runtimeDeps("resolver") ++ Seq(
      "com.github.plokhotnyuk.jsoniter-scala" %% "jsoniter-scala-macros" %
        workerDepVersion("jsoniter-scala-core_3") % "compile-internal,test-internal",
      "org.scalameta" %% "munit" % "1.3.6" % Test
    ),
    resolverJars := Def.uncached {
      val conv = fileConverter.value
      val main = conv.toPath((Compile / packageBin).value).toFile
      val deps = (Runtime / dependencyClasspath).value
        .map(a => conv.toPath(a.data).toFile)
        .filter(f => f.getName.endsWith(".jar") && f.getName != main.getName)
      val jars = main +: deps
      val names = jars.map(_.getName)
      val dupes = names.diff(names.distinct)
      if dupes.nonEmpty then sys.error(s"jar names in the resolver's closure must be unique: ${dupes.mkString(", ")}")
      jars
    },
    stage := Def.uncached {
      val dir = (ThisBuild / baseDirectory).value / "target" / "out" / "jvm" / "resolver-stage"
      IO.delete(dir)
      val jars = resolverJars.value
      jars.foreach(j => IO.copyFile(j, dir / j.getName))
      IO.writeLines(dir / "classpath.txt", jars.map(_.getName))
      dir
    },
    // `SCPM_RELEASE_TAG` (e.g. v0.2.0) names the GitHub release the jars are uploaded to; without
    // it the list says `release none`, and scpm can fetch the jars only through `resolverMirror`.
    bootstrapList := Def.uncached {
      val out = baseDirectory.value / "bootstrap.txt"
      val release = sys.env.get("SCPM_RELEASE_TAG").filter(_.nonEmpty).getOrElse("none")
      val lines = resolverJars.value.map(j => s"${sha256(j)} ${j.length} ${j.getName}")
      IO.writeLines(
        out,
        Seq(
          "# The resolver sidecar's jars (design §5.2.1), each pinned by sha256 and size; scpm",
          "# downloads them from the GitHub release named below, each uploaded as the asset <sha256>.jar.",
          "# Generated by `sbt resolver/bootstrapList` in worker/ (SCPM_RELEASE_TAG names the release); do not edit.",
          s"release $release"
        ) ++ lines
      )
      out
    }
  )

lazy val compileWorker = project
  .in(file("compile-worker"))
  .settings(
    name := "scpm-compile-worker",
    libraryDependencies ++= workerDeps ++ Seq(
      "com.github.plokhotnyuk.jsoniter-scala" %% "jsoniter-scala-macros" %
        workerDepVersion("jsoniter-scala-core_3") % "compile-internal",
      "org.scalameta" %% "munit" % "1.3.6" % Test
    )
  )

// Plain Java on purpose: the runner shares one flat classpath with the code under test, so it
// must not bring a Scala library of its own (see README).
lazy val testRunner = project
  .in(file("test-runner"))
  .settings(
    name := "scpm-test-runner",
    crossPaths := false,
    autoScalaLibrary := false,
    javacOptions ++= Seq("--release", "17", "-Xlint:all", "-Werror"),
    libraryDependencies ++= runtimeDeps("test-runner") ++ Seq(
      "com.github.sbt" % "junit-interface" % "0.13.3" % Test
    )
  )
