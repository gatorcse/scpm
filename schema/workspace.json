{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "scpm workspace",
  "description": "`scpm-workspace.yaml`: workspace-wide settings.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": [
        "string",
        "null"
      ]
    },
    "boms": {
      "description": "BOMs applied to every module: `org:name: <version>`, where the version may be exact, a\nrange, `catalog` or `catalog:<name>` (looked up by the BOM's coordinate).",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/Ver"
      },
      "default": {}
    },
    "catalog": {
      "description": "The default catalog, referenced as `catalog:`.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/Ver"
      },
      "default": {}
    },
    "catalogs": {
      "description": "Named catalogs, referenced as `catalog:<name>`.",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "$ref": "#/$defs/Ver"
        }
      },
      "default": {}
    },
    "ide": {
      "description": "IDE project files that a non-frozen `scpm install` keeps up to date (design §10).",
      "anyOf": [
        {
          "$ref": "#/$defs/WorkspaceIde"
        },
        {
          "type": "null"
        }
      ]
    },
    "lock": {
      "$ref": "#/$defs/LockSettings",
      "default": {}
    },
    "modules": {
      "description": "Globs of module directories (each containing `scpm.yaml`). `!` excludes.",
      "type": "array",
      "default": [],
      "items": {
        "type": "string"
      }
    },
    "organization": {
      "description": "Default organization (groupId) for modules.",
      "type": [
        "string",
        "null"
      ]
    },
    "overrides": {
      "description": "Forced versions applied workspace-wide.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/Ver"
      },
      "default": {}
    },
    "pipelineBase": {
      "type": [
        "string",
        "null"
      ]
    },
    "pipelines": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "default": {}
    },
    "policy": {
      "$ref": "#/$defs/Policy",
      "default": {}
    },
    "presets": {
      "description": "Named fragments that modules merge in with `extends:`.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/ModuleFile"
      },
      "default": {}
    },
    "repositories": {
      "description": "Maven repositories, in resolution order. Defaults to `[central]`.",
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/Repository"
      }
    },
    "scpm": {
      "description": "Pinned scpm version.",
      "anyOf": [
        {
          "$ref": "#/$defs/Ver"
        },
        {
          "type": "null"
        }
      ]
    },
    "tasks": {
      "description": "Task defaults inherited by every module.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/TaskDef"
      },
      "default": {}
    },
    "toolchain": {
      "$ref": "#/$defs/Toolchain",
      "default": {}
    },
    "versioning": {
      "anyOf": [
        {
          "$ref": "#/$defs/Versioning"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false,
  "$defs": {
    "Credentials": {
      "description": "`env:VAR` (bearer token) or `{user: env:U, password: env:P}` (basic auth).",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "properties": {
            "password": {
              "type": "string"
            },
            "user": {
              "type": "string"
            }
          },
          "required": [
            "user",
            "password"
          ]
        }
      ]
    },
    "DepDetails": {
      "type": "object",
      "properties": {
        "classifier": {
          "type": [
            "string",
            "null"
          ]
        },
        "exclude": {
          "description": "`org:name` patterns; `*` allowed in either part.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "natives": {
          "description": "System → classifier of this module's native jar (e.g. `linux-x86_64: linux-x86_64`),\nreplacing scpm's built-in mapping for it (and, in a preset or variant overlay, the whole\ninherited map); systems not listed get no native jar, and `{}`\nturns the mapping off. Needs the resolver sidecar.",
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "type": "string"
          }
        },
        "transitive": {
          "description": "Default `true`.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "type": {
          "description": "Artifact type, default `jar`.",
          "type": [
            "string",
            "null"
          ]
        },
        "version": {
          "$ref": "#/$defs/Ver"
        }
      },
      "additionalProperties": false,
      "required": [
        "version"
      ]
    },
    "DepSpec": {
      "description": "A dependency's value: a version spec string, or a detailed object.",
      "anyOf": [
        {
          "$ref": "#/$defs/Ver"
        },
        {
          "$ref": "#/$defs/DepDetails"
        }
      ]
    },
    "LockSettings": {
      "type": "object",
      "properties": {
        "jdk": {
          "description": "The JDK major version POM profiles are activated for when locking. Default: the project\nJDK's major version (`toolchain.jdk`), else 25.",
          "anyOf": [
            {
              "$ref": "#/$defs/Ver"
            },
            {
              "type": "null"
            }
          ]
        },
        "nativeClassifiers": {
          "description": "Native mappings for modules that arrive only transitively: each replaces scpm's built-in\nmapping for its module (`natives: {}` turns it off). Direct dependencies use `natives:`.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/NativeClassifiers"
          }
        },
        "systems": {
          "description": "The systems (OS and CPU architecture pairs, e.g. `linux-x86_64`, `macos-aarch64`) every\nclasspath is locked for; each machine uses its own. Unset: scpm's default set, which the\nlock's header then records. More than one system needs the resolver sidecar.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      },
      "additionalProperties": false
    },
    "ModuleFile": {
      "title": "scpm module",
      "description": "`scpm.yaml`: one module. Also the shape of presets and of `variants` overrides.",
      "type": "object",
      "properties": {
        "$schema": {
          "type": [
            "string",
            "null"
          ]
        },
        "boms": {
          "description": "BOMs: `org:name: <version>` (exact, a range, `catalog` or `catalog:<name>`).",
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/Ver"
          }
        },
        "compilerPlugins": {
          "description": "Compiler plugins (`org:::name` for full-cross Scala 2 plugins); added as `-Xplugin`.",
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/DepSpec"
          }
        },
        "dependencies": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/DepSpec"
          }
        },
        "env": {
          "description": "Environment variables for forked `run` and `test` JVMs.",
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "extends": {
          "description": "Presets to merge in, in order.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "generatedSources": {
          "description": "Directories under `${outDir}` (`.scpm/out/<variant>/`) written by tasks and compiled\nwith the main sources.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ide": {
          "description": "IDE settings (not allowed in `variants` overrides).",
          "anyOf": [
            {
              "$ref": "#/$defs/ModuleIde"
            },
            {
              "type": "null"
            }
          ]
        },
        "javacOptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "jvmOptions": {
          "description": "JVM options for forked `run` and `test` JVMs.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mainClass": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "description": "Module name; defaults to the directory name.",
          "type": [
            "string",
            "null"
          ]
        },
        "organization": {
          "type": [
            "string",
            "null"
          ]
        },
        "platforms": {
          "description": "Defaults to `[jvm]`.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Platform"
          }
        },
        "providedDependencies": {
          "description": "Compile-only (Maven `provided`).",
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/DepSpec"
          }
        },
        "publish": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "release": {
          "description": "Java release target, e.g. `17`. Defaults to the project JDK's major version.",
          "anyOf": [
            {
              "$ref": "#/$defs/Ver"
            },
            {
              "type": "null"
            }
          ]
        },
        "resources": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "runtimeDependencies": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/DepSpec"
          }
        },
        "scala": {
          "description": "Scala version(s). A list cross-builds. `none` marks a Java-only module.\nDefaults to `toolchain.scala`.",
          "anyOf": [
            {
              "$ref": "#/$defs/OneOrMany"
            },
            {
              "type": "null"
            }
          ]
        },
        "scalacOptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sources": {
          "description": "Source directories relative to the module. Default `src/main/scala`, `src/main/java`\nplus version- and platform-specific `src/main/scala-<x>` directories that exist.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "tasks": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/TaskDef"
          }
        },
        "testDependencies": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/DepSpec"
          }
        },
        "testResources": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "testSources": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "variants": {
          "description": "Overrides for variants matching a selector such as `2.13`, `js` or `js-2.13`.",
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/ModuleFile"
          }
        },
        "version": {
          "anyOf": [
            {
              "$ref": "#/$defs/Ver"
            },
            {
              "type": "null"
            }
          ]
        },
        "versionScheme": {
          "anyOf": [
            {
              "$ref": "#/$defs/VersionScheme"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "ModuleIde": {
      "description": "`ide` in a module file or a preset.",
      "type": "object",
      "properties": {
        "primary": {
          "description": "The variant `scpm idea` turns into this module's IntelliJ module, as a variant selector\n(`2.13`, `jvm-3`, …). IntelliJ modules can't share a content root, so a cross-built\nmodule gets one IntelliJ module. Default: the first variant (the first Scala version\nlisted).",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "NativeClassifiers": {
      "description": "`{module: org:name, natives: {<system>: <classifier>}}`.",
      "type": "object",
      "properties": {
        "module": {
          "type": "string"
        },
        "natives": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "module",
        "natives"
      ]
    },
    "OneOrMany": {
      "anyOf": [
        {
          "$ref": "#/$defs/Ver"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Ver"
          }
        }
      ]
    },
    "Platform": {
      "description": "The target platform of a module variant.",
      "type": "string",
      "enum": [
        "jvm",
        "js",
        "native"
      ]
    },
    "Policy": {
      "type": "object",
      "properties": {
        "minimumReleaseAge": {
          "description": "Refuse to lock versions younger than this, e.g. `1d`, `12h`.",
          "type": [
            "string",
            "null"
          ]
        },
        "minimumReleaseAgeExclude": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ReleaseAgeExclude"
          }
        },
        "securityBypass": {
          "description": "`advisory-fixed` (default) or `off`.",
          "type": [
            "string",
            "null"
          ]
        },
        "versionConflicts": {
          "description": "`error` (default) or `warn`: evictions that violate the evicted library's versionScheme.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "ReleaseAgeExclude": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "properties": {
            "coord": {
              "type": "string"
            },
            "expires": {
              "type": [
                "string",
                "null"
              ]
            },
            "reason": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "coord"
          ]
        }
      ]
    },
    "Repository": {
      "description": "A repository: a well-known name (`central`) or a full definition.",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "$ref": "#/$defs/RepositoryDef"
        }
      ]
    },
    "RepositoryDef": {
      "type": "object",
      "properties": {
        "allowInsecureCredentials": {
          "description": "Send credentials to this `http://` repository although plain HTTP exposes them on the\nnetwork. Without it, credentials only ever go over HTTPS. They are then sent to exactly\nthis URL's scheme, host and port.",
          "type": "boolean"
        },
        "credentials": {
          "description": "Omit to use coursier's credentials (`COURSIER_CREDENTIALS`, `credentials.properties`).",
          "anyOf": [
            {
              "$ref": "#/$defs/Credentials"
            },
            {
              "type": "null"
            }
          ]
        },
        "groups": {
          "description": "Group-id prefixes (`com.acme` covers `com.acme` and `com.acme.*`) served only by this\nrepository and any other that lists the same longest prefix: those artifacts are\nrestored from nowhere else, and nothing else is restored from here. Without it, the\nrepository serves every group no repository claims.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "id": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "url"
      ]
    },
    "TaskDef": {
      "description": "A task definition, pnpm style.",
      "type": "object",
      "properties": {
        "concurrencyGroup": {
          "type": [
            "string",
            "null"
          ]
        },
        "dependsOn": {
          "description": "`^task` = that task in each upstream module; `task` = same module.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "env": {
          "description": "Environment variables that are part of the cache key.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "inputs": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "outputs": {
          "description": "Declared outputs make the task cacheable; `[]` means \"no files\".",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "run": {
          "description": "Shell command, or `builtin:<name> [args]`. Omitted for built-in tasks like `compile`.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "Toolchain": {
      "type": "object",
      "properties": {
        "jdk": {
          "description": "JDK, e.g. `temurin:25`.",
          "type": [
            "string",
            "null"
          ]
        },
        "scala": {
          "description": "Default Scala version (or `catalog:`/`catalog:<name>`, looked up under the key `scala`).",
          "anyOf": [
            {
              "$ref": "#/$defs/Ver"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "Ver": {
      "description": "A version. Quote versions that contain a dot (`'2.10'`): YAML reads unquoted ones as floats.",
      "type": [
        "string",
        "integer"
      ]
    },
    "VersionScheme": {
      "type": "string",
      "enum": [
        "early-semver",
        "semver-spec",
        "pvp",
        "strict",
        "always"
      ]
    },
    "Versioning": {
      "type": "object",
      "properties": {
        "changes": {
          "type": [
            "string",
            "null"
          ]
        },
        "fixed": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "ignore": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "lanes": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "maxBump": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "WorkspaceIde": {
      "description": "`ide` in the workspace file: which IDE files a non-frozen `scpm install` regenerates.",
      "type": "object",
      "properties": {
        "idea": {
          "description": "Regenerate the IntelliJ project files (`scpm idea`) after every non-frozen install.\nWithout it, they are regenerated only when scpm generated them before.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "metals": {
          "description": "Regenerate `.metals/mbt.json` (Metals v2) after every non-frozen install. Without it,\nthe file is regenerated only when it already exists.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "semanticdb": {
          "description": "Compile Scala sources with SemanticDB output (in each classes directory, under\n`META-INF/semanticdb`), which Metals v1 needs over BSP for references, rename,\nimplementations and code lenses. `scpm compile` and `scpm bsp` both apply it, so they\nshare build outputs. Scala 3 uses the compiler's own `-Xsemanticdb`; Scala 2 the locked\n`semanticdb-scalac` compiler plugin.",
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
